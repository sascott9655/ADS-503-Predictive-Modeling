library(caret)
library(tidyverse)
library(kernlab)
library(dplyr)
library(tibble)
library(mlbench)
library(randomForest)
library(corrplot)
library(ggplot2)
#install.packages("patchwork", repos = "https://cloud.r-project.org")
#url("https://cloud.r-project.org")
#options(download.file.method = "wininet")
#install.packages("patchwork", repos = "https://cloud.r-project.org")
library(patchwork)
library(Hmisc)
library(e1071)
data_url <- "https://raw.githubusercontent.com/sascott9655/GDSC-Project/refs/heads/main/GDSC_DATASET.csv"
data  <- read.csv(data_url)
str(data)
head(data)
dim(data)
# cleaning the data
# verifying the COSMIC_ID numbers are unique to each CELL_LINE_NAME
data %>%
group_by(COSMIC_ID) %>%
summarise(n_unique = n_distinct(CELL_LINE_NAME)) %>%
filter(n_unique > 1)
# verifying the DRUG_ID numbers are unique to each DRUG_NAME
data %>%
group_by(DRUG_ID) %>%
summarise(n_unique = n_distinct(DRUG_NAME)) %>%
filter(n_unique > 1)
# assessing the redundancy of the TCGA columns
tcga_match <- data$TCGA_DESC == data$Cancer.Type..matching.TCGA.label.
table(tcga_match, useNA = "ifany")
sum(data$Cancer.Type..matching.TCGA.label. == "")
sum(data$TCGA_DESC == "")
sum(data$Cancer.Type..matching.TCGA.label. == "" &
data$TCGA_DESC == "")
# removing irrelevant and redundant columns
data2 <- data %>%
select(-COSMIC_ID, -DRUG_ID, -Screen.Medium, -Growth.Properties, -CNA, -Gene.Expression, -Methylation)
str(data2)
# looking for na and blank values
data2 %>%
summarise(across(everything(), ~sum(is.na(.))))%>% #
t() #transposes the table from wide to tall, making it easier to read
blank <- sapply(data2, function(x) sum(x == "", na.rm = TRUE)) #na counts
as_tibble(list( #tibble of na counts by each predictor
column = names(blank),
empty_count = as.vector(blank)
))
# reference Cancer.Type..matching.TCGA.label. to enter values for TCGA_DESC
data2$Cancer.Type..matching.TCGA.label. #CAncer Type value
unique(data2$Cancer.Type..matching.TCGA.label.)
data2 <- data2 %>%
mutate(
TCGA_DESC = case_when(
TCGA_DESC == "" & Cancer.Type..matching.TCGA.label. == "" ~ "UNCLASSIFIED1",
TCGA_DESC == "" ~ Cancer.Type..matching.TCGA.label., #copy the cancer type from CancerType to fill TCGA_DESC
TRUE ~ TCGA_DESC #otherwise keep original TCGA_DESC value
)
)
blank <- sapply(data2, function(x) sum(x == "", na.rm = TRUE))
as_tibble(list(
column = names(blank),
empty_count = as.vector(blank)
))
unique(data2$TCGA_DESC) #reduces the amount of unique values to ones that matter
# reference TCGA_DESC to enter GDSC.Tissue.descriptor.1 values for blank values in GDSC.Tissue.descriptor.2
length(unique(data2$GDSC.Tissue.descriptor.1))
length(unique(data2$GDSC.Tissue.descriptor.2)) #more unique descriptor 2's than 1 (noting this because it might be useful to keep descriptor 2)
length(unique(data2$TCGA_DESC))
?filter
gdsc_miss <- data2 %>%
filter(GDSC.Tissue.descriptor.1 != "", !is.na(GDSC.Tissue.descriptor.1)) %>% #Only keep rows where GDSC.Tissue.descriptor.1 actually has a value.”
summarise(n = n(), .groups = "drop") %>% #Count how often each TCGA_DESC pairs with each GDSC descriptor
group_by(TCGA_DESC) %>%
slice_max(n, n = 1, with_ties = FALSE) %>%  #For each TCGA_DESC, keep only the most common GDSC descriptor
ungroup() %>%
select(TCGA_DESC, GDSC.Tissue.descriptor.1)
